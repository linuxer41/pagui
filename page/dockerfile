# Stage 1: Builder — contexto = raíz del monorepo (incluye shared/)
FROM node:22 AS builder
WORKDIR /usr/src/app

# @pagui/shared = file:../shared → debe existir ANTES de npm install
COPY shared/ ./shared/
COPY page/package.json page/bun.lock ./page/
RUN cd page && npm install

# Copia el resto del código fuente de page
COPY page/ ./page/

# SSR (adapter-node): las API keys NO se pasan aquí — se leen en runtime
# desde process.env ($env/dynamic/private) con -e al correr el contenedor.
RUN cd page && npm run build

# Stage 2: Release — servidor Node ejecutado con bun
FROM oven/bun:1 AS release
WORKDIR /usr/src/app

# Copia solo los archivos generados por el proceso de construcción
COPY --from=builder /usr/src/app/page/build ./build

# Expone el puerto (ajusta según tu aplicación)
EXPOSE 3000/tcp

# Ejecuta la aplicación
USER bun
ENTRYPOINT [ "bun", "./build/index.js" ]
